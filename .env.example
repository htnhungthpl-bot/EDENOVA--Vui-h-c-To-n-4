# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG EDUNOVA (MẪU)
# Lưu ý: Không lưu khóa thật vào kho lưu trữ mã nguồn
# ==========================================

# Khóa API Gemini cho phân tích sư phạm và trợ giảng AI (phía server)
# AI Studio tự động tiêm khóa này từ Secrets panel tại thời điểm thực thi.
GEMINI_API_KEY=""

# Đường dẫn URL của ứng dụng
APP_URL="http://localhost:3000"

# Cổng dịch vụ
PORT=3000

# Trạng thái môi trường: development | production | test
NODE_ENV="development"

# Cấu hình Firebase (sẽ cấu hình chi tiết tại Giai đoạn tích hợp cơ sở dữ liệu)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

